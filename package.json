{
  "name": "central-policy-mcp",
  "version": "2.0.0",
  "description": "MCP service for accessing and analyzing central government policies from China",
  "main": "build/index.js",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node build/index.js",
    "dev": "tsc --watch",
    "test": "npm run build && node --test --test-concurrency=1 tests/*.test.mjs",
    "examples": "npm run build && node scripts/examples.mjs"
  },
  "keywords": [
    "mcp",
    "policy",
    "government",
    "china",
    "analysis"
  ],
  "author": {
    "name": "Xingyu Chen",
    "email": "guangxiangdebizi@gmail.com",
    "url": "https://github.com/guangxiangdebizi/"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "@modelcontextprotocol/node": "2.1.2",
    "cheerio": "1.1.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@modelcontextprotocol/client": "2.4.0",
    "typescript": "^5.3.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/guangxiangdebizi/China-Central-Policy-MCP.git"
  },
  "homepage": "https://github.com/guangxiangdebizi/China-Central-Policy-MCP#readme",
  "engines": {
    "node": ">=20.18.1"
  },
  "overrides": {
    "cheerio": {
      "undici": "8.12.2"
    }
  }
}
